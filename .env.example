# Copier ce fichier en .env et remplir les valeurs
# IMPORTANT : .env ne doit JAMAIS être commité sur Git

# France Travail API (https://francetravail.io/data/api/offres-emploi)
FT_CLIENT_ID=votre_client_id
FT_CLIENT_SECRET=votre_client_secret

# Base de données (local Docker)
DB_URL=jdbc:postgresql://localhost:5432/skillmap
DB_USER=skillmap
DB_PASS=skillmap

# Redis (local Docker)
REDIS_HOST=localhost
REDIS_PORT=6379

# GCP (pour déploiement uniquement)
GCP_PROJECT_ID=votre-project-id
GCP_REGION=europe-west1
